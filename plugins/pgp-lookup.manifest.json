{
  "identifier": "run.vineyard.pluginpacks.pgp_lookup",
  "content_type": "vineyard:pluginpack",
  "name": "PGP Key Lookup",
  "version": "1.0.1",
  "description": "Finds OpenPGP public keys published for email addresses on public key directories. Desktop only.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "key",
  "platforms": {
    "primary": "desktop",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    },
    "desktop": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs",
      "min_app_version": "0.1.0"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.pgp_lookup",
      "content_type": "vineyard:plugin",
      "name": "PGP Key Lookup",
      "version": "1.0.1",
      "description": "Looks up OpenPGP public keys published for each selected Email Address on keys.openpgp.org, keyserver.ubuntu.com, pgpkeys.eu and keys.mailvelope.com. Creates one PGP Key node per distinct fingerprint (key ID, algorithm, key size, creation/expiration, User IDs, revocation, armored key, sources), linked \"key bound to\" to each email it was found for. Desktop only.",
      "icon": "key",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "email_address"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "pgp_key"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://keys.openpgp.org/vks/v1/",
            "methods": [
              "GET"
            ],
            "purpose": "Exact by-email lookup on keys.openpgp.org (the only keyserver answering CORS)."
          }
        ],
        "web_probe": {
          "purpose": "Exact by-email HKP lookups on keyserver.ubuntu.com, pgpkeys.eu, and keys.mailvelope.com — servers that answer no CORS headers."
        }
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
